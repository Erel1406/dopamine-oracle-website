# AI — Oracle chat + daily horoscopes.
# If OPENROUTER_API_KEY is set it takes precedence (cheap test model,
# deepseek-v4-flash). Otherwise the Vercel AI Gateway is used.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (https://dashboard.stripe.com → Developers)
# STRIPE_PRICE_ID: recurring price (€9.99/month) created in the dashboard
# STRIPE_WEBHOOK_SECRET: from the webhook endpoint for /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Secret for signing the free-questions cookie (any long random string)
FREE_QUESTIONS_COOKIE_SECRET=

# Supabase — database + per-user daily token cap (150k/day).
# Create the project in an EU region (Frankfurt). Without these the cap is
# simply inactive. Service-role key is server-only — never expose it client-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
